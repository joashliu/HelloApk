<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 通知權限（Android 13+ 需要） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        ⚠️ 下面呢個係「系統保護權限」，第三方 App 無法直接申請，
        真正授權由用戶喺「設定 → 通知存取權」開啟。
        喺呢度聲明只係為咗 lint 靜音，加 tools:ignore 避免警告。
    -->
    <uses-permission
        android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!--
        ★ 新增：OCR 長按功能所需權限
        - FOREGROUND_SERVICE：基礎前台服務權限（Android 9+）
        - FOREGROUND_SERVICE_MEDIA_PROJECTION：Android 14+ 必須聲明，
          否則 startForeground(FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION) 會拋 SecurityException
        - VIBRATE：長按磁貼震動回饋
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        ★ 新增：Android 11+ 查詢已安裝 App
        如果你喺代碼用 packageManager.getPackageInfo("com.mtr.mobile", 0) 檢查 App 有冇裝，
        就需要喺呢度聲明，否則會拋 NameNotFoundException。
    -->
    <queries>
        <package android:name="com.mtr.mobile" />
        <package android:name="com.octopus.card" />
        <package android:name="com.octopuscards.oepay" />
        <package android:name="com.hsbc.hsbc_hk" />
        <package android:name="com.hangsengbank.hangseng" />
        <intent>
            <action android:name="android.service.notification.NotificationListenerService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="記帳"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- ML Kit 去背模型 -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ★ 新增：OCR 授權中介 Activity
            - 透明主題：用戶只會見到系統「允許螢幕截圖」對話框
            - noHistory + excludeFromRecents：唔會殘留喺返回棧 / 最近任務
            - exported=false：只由 QuickAddTileService 內部啟動
            - configChanges：避免授權對話框開合時重建
        -->
        <activity
            android:name=".OcrCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            ★ 新增：OCR 前台服務
            - foregroundServiceType="mediaProjection"：Android 14+ 必須
            - exported=false：只由 App 內部（OcrCaptureActivity）啟動
        -->
        <service
            android:name=".OcrForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 監控易乘碼 / 八達通 / 銀行通知 -->
        <service
            android:name=".PaymentNotificationListener"
            android:label="易乘碼記賬助手"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 處理通知按鈕廣播（例如快速記賬按鈕） -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- 快速記帳快捷磁貼（短按邏輯不變；長按由 handleSecondaryClick 處理） -->
        <service
            android:name=".QuickAddTileService"
            android:label="快速記帳"
            android:icon="@drawable/ic_tile_add"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
            <!--
                ★ 新增：提示系統此 Tile 支援長按（Android 14+）
                冇呢個 meta-data 時，部分 ROM 唔會派發 handleSecondaryClick()
            -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- FileProvider，畀相機寫入臨時相片檔案 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

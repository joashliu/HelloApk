<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">記帳</string>
    <string name="accessibility_description">此服務僅用於偵測支付 App 的通知，作為畫面擷取及記帳功能的觸發信號。絕不會主動讀取您的私人畫面或對話內容，並且不設任何後台持續擷取。</string>
    <!-- 🟢 Ledger 讀屏：只喺用戶撳懸浮掣時讀畫面文字節點（唔截圖、唔寫相簿） -->
    <string name="ledger_accessibility_desc">用於在您按下懸浮按鈕時讀取畫面金額文字（例如 HKD），以便快速記帳。不會截圖、不會儲存畫面，亦不會在背景持續監聽內容。</string>
    <string name="shortcut_quick_add_short">快速記賬</string>
    <string name="shortcut_quick_add_long">直接開啟鍵盤記一筆</string>
    <string name="shortcut_voice_add_short">語音記帳</string>
    <string name="shortcut_voice_add_long">用語音講項目同金額</string>
</resources>
